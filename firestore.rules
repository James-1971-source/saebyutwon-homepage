rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      allow read, write: if true;
    }
    match /donations/{donationId} {
      allow read, write: if true;
    }
    match /volunteers/{volunteerId} {
      allow read, write: if true;
    }
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }
    match /admin_users/{userId} {
      allow read, write: if true;
    }
  }
}

